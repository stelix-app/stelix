    "about.creditsNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelix doesn't host models: each one is downloaded from its source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelix non ospita i modelli: ognuno si scarica dalla sua fonte."
          }
        }
      }
    },
    "about.freeSoftware": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelix is free and open source software under the GNU GPL v3: you can use, share and modify it. As the license says, it comes as is, without warranty."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelix è software libero e open source, sotto la GNU GPL v3: puoi usarlo, condividerlo e modificarlo. Come prevede la licenza, è fornito così com'è, senza garanzia."
          }
        }
      }
    },
    "about.lgpl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes LAME (Copyright The LAME Project) and the SoX Resampler library (Copyright 2007-2018 Rob Sykes), under the GNU LGPL. Their licenses are in Third-Party Notices."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include LAME (Copyright The LAME Project) e la libreria SoX Resampler (Copyright 2007-2018 Rob Sykes), sotto la GNU LGPL. Le loro licenze sono in Note di terze parti."
          }
        }
      }
    },
