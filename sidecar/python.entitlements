<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sidecar's interpreter runs with the hardened runtime. Its extension modules (numpy, MLX)
	     are signed with the same certificate as the app, but a self-signed certificate has no Team ID,
	     and without one library validation refuses every library that is not Apple's. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
